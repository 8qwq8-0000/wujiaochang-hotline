@tool
extends McpTestSuite


func suite_name() -> String:
	return "dash_and_cyberware"


func test_dash_baseline_is_data_driven_and_always_available() -> void:
	var config: DashConfigData = load("res://resources/player/default_dash_config.tres")
	assert_eq(config.walk_speed, 125.0)
	assert_eq(config.dash_speed, 420.0)
	assert_eq(config.dash_duration, 0.2)
	assert_eq(config.dash_cooldown, 1.2)
	assert_eq(config.invulnerability_seconds, 0.15)
	assert_eq(config.collision_damage, 2)
	assert_eq(config.collision_stagger_seconds, 0.65)


func test_cyberware_resources_keep_confirmed_tuning() -> void:
	var smart: CyberwareData = load("res://resources/cyberware/smart_fire.tres")
	var explosive: CyberwareData = load("res://resources/cyberware/explosive_magazine.tres")
	var tactical: CyberwareData = load("res://resources/cyberware/tactical_coprocessor.tres")
	var optical: CyberwareData = load("res://resources/cyberware/optical_intruder.tres")
	var kill_heat_sink: CyberwareData = load("res://resources/cyberware/kill_energy_sink.tres")
	var heat_threshold_pulser: CyberwareData = load("res://resources/cyberware/shock_pulser.tres")
	var momentum_recovery_tendon: CyberwareData = load("res://resources/cyberware/momentum_recovery_tendon.tres")
	var trajectory_echo_processor: CyberwareData = load("res://resources/cyberware/trajectory_echo_processor.tres")
	var ballistic_takeover_protocol: CyberwareData = load("res://resources/cyberware/ballistic_takeover_protocol.tres")
	var arc_ballistic_cortex: CyberwareData = load("res://resources/cyberware/arc_ballistic_cortex.tres")
	var inertial_inversion_vertebra: CyberwareData = load("res://resources/cyberware/inertial_inversion_vertebra.tres")
	var axon_recycler: CyberwareData = load("res://resources/cyberware/axon_recycler.tres")
	var micro_rotor_reflex_bundle: CyberwareData = load("res://resources/cyberware/micro_rotor_reflex_bundle.tres")
	var predatory_vestibular_ring: CyberwareData = load("res://resources/cyberware/predatory_vestibular_ring.tres")
	assert_eq(smart.module_id, CyberwareController.SMART_FIRE)
	assert_eq(smart.targeting_half_angle_degrees, 25.0)
	assert_eq(smart.homing_turn_degrees_per_second, 360.0)
	assert_eq(explosive.module_id, CyberwareController.EXPLOSIVE_MAGAZINE)
	assert_eq(explosive.explosion_radius, 48.0)
	assert_eq(explosive.explosion_damage, 1)
	assert_eq(tactical.module_id, CyberwareController.TACTICAL_COPROCESSOR)
	assert_eq(optical.module_id, CyberwareController.OPTICAL_INTRUDER)
	assert_eq(optical.optical_reacquire_delay, 0.6)
	assert_eq(kill_heat_sink.module_id, CyberwareController.KILL_HEAT_SINK)
	assert_eq(kill_heat_sink.circuit_energy_cost, 10.0)
	assert_eq(kill_heat_sink.fixed_energy_refund, 20.0)
	assert_eq(heat_threshold_pulser.module_id, CyberwareController.HEAT_THRESHOLD_PULSER)
	assert_eq(heat_threshold_pulser.circuit_energy_cost, 16.0)
	assert_eq(heat_threshold_pulser.display_name, "冲击脉冲器")
	assert_eq(momentum_recovery_tendon.module_id, CyberwareController.MOMENTUM_RECOVERY_TENDON)
	assert_eq(momentum_recovery_tendon.circuit_energy_cost, 12.0)
	assert_eq(trajectory_echo_processor.module_id, CyberwareController.TRAJECTORY_ECHO_PROCESSOR)
	assert_eq(trajectory_echo_processor.trigger_cooldown, 4.0)
	assert_eq(trajectory_echo_processor.trajectory_echo_radius, 96.0)
	assert_eq(trajectory_echo_processor.trajectory_echo_damage_ratio, 0.5)
	assert_eq(ballistic_takeover_protocol.module_id, CyberwareController.BALLISTIC_TAKEOVER_PROTOCOL)
	assert_eq(ballistic_takeover_protocol.trigger_cooldown, 6.0)
	assert_eq(ballistic_takeover_protocol.takeover_radius, 28.0)
	assert_eq(ballistic_takeover_protocol.takeover_target_radius, 220.0)
	assert_eq(ballistic_takeover_protocol.takeover_homing_turn_degrees_per_second, 720.0)
	assert_eq(arc_ballistic_cortex.module_id, CyberwareController.ARC_BALLISTIC_CORTEX)
	assert_eq(arc_ballistic_cortex.trigger_cooldown, 0.0)
	assert_eq(arc_ballistic_cortex.arc_chain_radius, 64.0)
	assert_eq(arc_ballistic_cortex.arc_paralysis_seconds, 0.2)
	assert_eq(arc_ballistic_cortex.arc_chain_targets, 2)
	assert_eq(inertial_inversion_vertebra.module_id, CyberwareController.INERTIAL_INVERSION_VERTEBRA)
	assert_eq(inertial_inversion_vertebra.trigger_cooldown, 3.0)
	assert_eq(inertial_inversion_vertebra.inertia_pulse_radius, 56.0)
	assert_eq(inertial_inversion_vertebra.inertia_pulse_stagger_seconds, 0.35)
	assert_eq(inertial_inversion_vertebra.inertia_pulse_knockback, 180.0)
	assert_eq(axon_recycler.module_id, CyberwareController.AXON_RECYCLER)
	assert_eq(axon_recycler.trigger_cooldown, 0.0)
	assert_eq(axon_recycler.axon_cooldown_reduction, 0.75)
	assert_eq(micro_rotor_reflex_bundle.module_id, CyberwareController.MICRO_ROTOR_REFLEX_BUNDLE)
	assert_eq(micro_rotor_reflex_bundle.trigger_cooldown, 0.0)
	assert_eq(micro_rotor_reflex_bundle.micro_rotor_hit_refund_ratio, 0.25)
	assert_eq(micro_rotor_reflex_bundle.micro_rotor_kill_refund_ratio, 0.5)
	assert_eq(predatory_vestibular_ring.module_id, CyberwareController.PREDATORY_VESTIBULAR_RING)
	assert_eq(predatory_vestibular_ring.trigger_cooldown, 0.0)


func test_player_scene_uses_new_runtime_controllers() -> void:
	var player := track(load("res://scenes/actors/player/player.tscn").instantiate()) as PlayerController
	assert_true(player.get_node_or_null("DashController") is DashController)
	assert_true(player.get_node_or_null("CyberwareController") is CyberwareController)
	assert_true(player.get_node_or_null("MobilityController") == null)
